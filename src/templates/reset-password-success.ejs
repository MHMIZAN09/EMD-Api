<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password changed - Emergency Management</title>
  </head>
  <body style="margin:0;padding:0;background:#eef2f7;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef2f7;">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #dde5ef;box-shadow:0 8px 24px rgba(31,41,55,.06);">
            <tr>
              <td style="background:#a71930;padding:28px 32px;text-align:center;">
                <table role="presentation" align="center" cellspacing="0" cellpadding="0">
                  <tr>
                    <td style="width:38px;height:38px;border-radius:50%;background:#ffffff;text-align:center;color:#a71930;font-size:21px;font-weight:700;line-height:38px;">+</td>
                    <td style="padding-left:10px;color:#ffffff;font-size:20px;font-weight:700;text-align:left;">Emergency Management</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:40px 40px 36px;">
                <table role="presentation" width="64" cellspacing="0" cellpadding="0" style="margin-bottom:20px;">
                  <tr>
                    <td align="center" style="width:64px;height:64px;border-radius:50%;background:#eaf7ef;color:#198754;font-size:30px;font-weight:700;line-height:64px;">&#10003;</td>
                  </tr>
                </table>

                <p style="margin:0 0 8px;color:#198754;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:1.4px;">Security update</p>
                <h1 style="margin:0 0 14px;font-size:28px;line-height:36px;color:#172033;">Password changed successfully</h1>
                <p style="margin:0 0 24px;font-size:16px;line-height:26px;color:#5f6b7a;">
                  Hello <strong style="color:#172033;"><%= name %></strong>,
                  the password for your Emergency Management account has been changed successfully.
                </p>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f7f9fc;border:1px solid #edf1f5;border-radius:12px;">
                  <tr>
                    <td width="44" valign="top" style="padding:18px 4px 18px 18px;font-size:20px;color:#198754;">&#9679;</td>
                    <td style="padding:18px 18px 18px 8px;font-size:14px;line-height:22px;color:#58677a;">
                      <strong style="color:#172033;">Your account is secure</strong><br />
                      You can now sign in using your new password.
                    </td>
                  </tr>
                </table>

                <p style="margin:24px 0 0;font-size:13px;line-height:21px;color:#7a8698;">
                  If you did not make this change, contact the support team immediately and secure your account.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:22px 32px;background:#f8fafc;border-top:1px solid #edf1f5;text-align:center;">
                <p style="margin:0;font-size:12px;line-height:20px;color:#8995a5;">
                  Emergency Management System<br />
                  Fast, coordinated emergency assistance
                </p>
              </td>
            </tr>
          </table>
          <p style="margin:18px 0 0;font-size:12px;line-height:18px;color:#8a96a6;">This is an automated security email. Please do not reply.</p>
        </td>
      </tr>
    </table>
  </body>
</html>